{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=worlddeciding;Username=worlddeciding;Password=REPLACE_IN_USER_SECRETS"
  },
  "Redis": {
    "Configuration": "127.0.0.1:6379",
    "InstanceName": "WorldDeciding_"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Api": {
    "BaseUrl": "https://localhost:7200"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "worlddeciding-api-dev",
    "Audience": "worlddeciding-frontend-dev",
    "AccessTokenMinutes": 15,
    "Key": "worlddeciding-local-dev-jwt-key-change-this-before-shared-use"
  },
  "Networking": {
    "TrustedProxies": [ "127.0.0.1", "::1" ]
  },
  "RefreshCookie": {
    "Name": "wd_refresh",
    "Path": "/api/auth/refresh",
    "Days": 30,
    "HttpOnly": true,
    "Secure": false,
    "SameSite": "Lax"
  }
}
