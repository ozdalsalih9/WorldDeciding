{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=worlddeciding;Username=worlddeciding;Password=REPLACE_WITH_DB_PASSWORD"
  },

  "Jwt": {
    "Issuer": "WorldDeciding",
    "Audience": "WorldDeciding",
    "Key": "REPLACE_WITH_JWT_SECRET_KEY_MIN_32_CHARS",
    "AccessTokenMinutes": "15"
  },

  "RefreshToken": {
    "Pepper": "REPLACE_WITH_SECURE_PEPPER_MIN_16_CHARS"
  },

  "Redis": {
    "Configuration": "127.0.0.1:6379",
    "InstanceName": "WorldDeciding_"
  },

  "Serilog": {
    "MinimumLevel": "Information"
  },

  "AllowedHosts": "*",

  "GeoIp": {
    "DatabasePath": "IP2LOCATION-LITE-DB1/IP2LOCATION-LITE-DB1.BIN"
  },

  "Networking": {
    "TrustedProxies": [ "127.0.0.1", "::1" ]
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_WITH_SMTP_USERNAME",
    "Password": "REPLACE_WITH_SMTP_APP_PASSWORD",
    "EnableSsl": true,
    "FromEmail": "REPLACE_WITH_FROM_EMAIL",
    "FromName": "WorldDeciding"
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },

  "Api": { "BaseUrl": "https://localhost:7200" },

  "Privacy": {
    "IpSalt": "REPLACE_WITH_SECURE_RANDOM_GUID"
  },

  "Gemini": {
    "ApiKey": "REPLACE_WITH_GEMINI_API_KEY"
  }
}
