{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",





  "Redis": {
    "Configuration": "127.0.0.1:6379",
    "InstanceName": "WorldDeciding_"
  },



  "Gemini": {
    "ApiKey": "REPLACE_WITH_GEMINI_API_KEY"
  },

  "RefreshCookie": {
    "Name": "wd_refresh",
    "Path": "/api/auth/refresh",
    "Days": 30,
    "HttpOnly": true,
    "Secure": false,
    "SameSite": "Lax"
  }
}
